# ---------------------------------------------------------------------------
# KreateUp DesignSeries Portal — environment template
# Copy to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Database. SQLite for local development (zero setup).
# For production on Vercel, switch prisma/schema.prisma provider to "postgresql"
# and point this at your Postgres connection string.
DATABASE_URL="file:./dev.db"

# 32+ character secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Session lifetime in days.
SESSION_DAYS="7"

# Default password given to every seeded account (they are asked to change it).
# Seeded users can also sign in with their roll number as the password.
SEED_DEFAULT_PASSWORD="designseries@2026"

# Public app name / URL used in metadata and generated gate passes.
NEXT_PUBLIC_APP_NAME="KreateUp DesignSeries Portal"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
